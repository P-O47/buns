local httpService = game:GetService("HttpService")
local players = game:GetService("Players")
local localPlayer = players.LocalPlayer

local function f1(text)
  local upper = string.upper(tostring(text))
  local v1 = 1
  local replaced = string.gsub(upper, ",", "")

  if string.find(replaced, "K") then
    v1 = 1000
  end

  if string.find(replaced, "M") then
    v1 = 1000000
  end

  if string.find(replaced, "B") then
    v1 = 1000000000
  end

  return (tonumber(string.match(replaced, "[%d%.]+")) or 0) * v1
end

local function getLabel()
  return localPlayer:WaitForChild("PlayerGui"):WaitForChild("Topbar"):WaitForChild("Topbar"):WaitForChild("Left"):WaitForChild("Coins"):WaitForChild("Label")
end

local label = getLabel()

-- https://lua-x.online
local function f2(p1, text2)
  local text3 = string.format("👤 %s | 💰 %s", localPlayer.Name, text2)

  if p1 then
    text3 = "START " .. text3
  end

  httpService:JSONEncode({ username = "Coin Tracker", content = text3 })
end

local text4 = label.Text
local v2 = f1(text4)
f2(true, text4)

task.spawn(function()
  while task.wait(10) do
    local text5 = label.Text
    local v3 = f1(text5)

    if v3 > v2 then
      f2(false, text5)
    end

    v2 = v3
  end
end)
